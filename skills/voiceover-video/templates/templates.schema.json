{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Voiceover Video Theme Manifest",
  "type": "object",
  "required": ["templates"],
  "properties": {
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "name", "mood", "best_for", "blocks"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "file": { "type": "string" },
          "name": { "type": "string" },
          "default": { "type": "boolean" },
          "mood": { "type": "string" },
          "best_for": { "type": "array", "items": { "type": "string" } },
          "fonts": { "type": "string" },
          "motion": {
            "type": "object",
            "properties": {
              "enter": { "type": ["string", "null"] },
              "shake": { "type": "number" },
              "flash": { "type": "number" },
              "pulse": { "type": "number" }
            }
          },
          "blocks": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
